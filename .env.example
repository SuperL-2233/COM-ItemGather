# 应用与网络（生产后端只监听本机，由现有 Nginx 对外提供 HTTPS）
APP_ENV=production
APP_LISTEN_ADDR=127.0.0.1:8088
APP_PUBLIC_URL=https://ideas.example.com
COOKIE_SECURE=true

# 持久化路径
DATABASE_PATH=/srv/com-itemgather/data/app.db
ATTACHMENT_DIR=/srv/com-itemgather/data/attachments

# OpenAI-compatible Chat Completions；密钥仅放在服务器环境文件中
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT=60s
AI_MAX_RETRIES=3
AI_WORKER_CONCURRENCY=1

# 会话有效期
SESSION_DEFAULT_DAYS=7
SESSION_REMEMBER_DAYS=90

# 图片与存储限制
MAX_UPLOAD_SIZE=3MiB
MAX_ATTACHMENTS_PER_IDEA=10
MAX_STORAGE_MB=2048

# 一致性备份：同时应用天数与份数上限
BACKUP_DIR=/srv/com-itemgather/backups
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP=10

# 仅本地开发时 Go 回退提供前端静态文件；生产由 Nginx 直接提供
WEB_DIST=web/dist

# 游戏主仓库 README 和 Issues：共用 GitHub App 安装认证，不需要成员授权个人 GitHub
# 留空时仍可编辑、保存个人草稿；配置完整后可读取和提交 README.md
# 问题功能另需 Issues: Read and write，并在安装设置中接受新增权限；不需要额外配置项
README_GITHUB_REPOSITORY=SuperL-2233/CallOfMommy
README_GITHUB_BRANCH=main
README_GITHUB_APP_ID=
README_GITHUB_INSTALLATION_ID=
# PEM 私钥须在前端/代码仓库之外，且服务账号可读
README_GITHUB_PRIVATE_KEY_FILE=
